{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/spec/canonical-v1",
  "title": "Nexus Canonical Pack v1 (draft)",
  "type": "object",
  "required": ["id", "version", "imports", "specVersion", "references"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "specVersion": { "type": "string", "pattern": "^nexus\\.canonical\\.v1" },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "src", "rev", "path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "src": { "type": "string", "minLength": 1 },
          "rev": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "references": {
      "type": "object",
      "properties": {
        "skills": { "type": "array", "items": { "type": "string", "pattern": "^skills/.+/SKILL\\.md$" } },
        "commands": { "type": "array", "items": { "type": "string", "pattern": "^commands/.+\\.md$" } },
        "agents": { "type": "array", "items": { "type": "string", "pattern": "^agents/.+\\.md$" } },
        "hooks": { "type": "array", "items": { "type": "string", "pattern": "^hooks/.+" } },
        "mcp": { "type": "array", "items": { "type": "string", "pattern": "^mcp/.+\\.json$" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
